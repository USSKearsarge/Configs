{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "palette": {
    "pink": "#FFA2FF",
    "#44EEC4": "#44EEC4",
    "gray": "#808080"
    },
    "logo": {
        "type": "kitty",
        "source": "/home/jakub/Pictures/Logo.png",
        "width": 25,
        "height": 20,
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;255;162;255m┌──────────────────────Hardware──────────────────────┐\u001b[0m"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#44EEC4"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#44EEC4"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#44EEC4"
        },
        {
            "type": "memory",
            "key": "│ ├󰘚",
            "keyColor": "#44EEC4"
        },
        {
            "type": "disk",
            "key": "│ ├󰋊",
            "keyColor": "#44EEC4",
            "folders": ["/"]
        },
        {
            "type": "disk",
            "key": "└ └󰋊",
            "keyColor": "#44EEC4",
            "folders": ["/home"]
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;162;255m└────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;162;255m┌──────────────────────Software──────────────────────┐\u001b[0m"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#44EEC4",
            "format": "KearsargeOS"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#44EEC4"
        },
        {
            "type": "bios",
            "key": "│ ├",
            "keyColor": "#44EEC4"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#44EEC4"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#44EEC4"
        },
        {
            "type": "de",
            "key": " WM",
            "keyColor": "#44EEC4"
        },
        {
            "type": "lm",
            "key": "│ ├",
            "keyColor": "#44EEC4"
        },
        {
            "type": "wm",
            "key": "│ ├",
            "keyColor": "#44EEC4"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#44EEC4"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#44EEC4"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;162;255m└────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;162;255m┌─────────────────Uptime / Age / DT──────────────────┐\u001b[0m"
        },
        {
            "type": "command",
            "key": "  OS Age ",
            "keyColor": "#44EEC4",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "#44EEC4"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "#44EEC4"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;162;255m└────────────────────────────────────────────────────┘"
        },


        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }

    ]
}
